{
  "name": "project-presets-demo",
  "version": "2.2.0",
  "packageManager": "pnpm@11.28.0",
  "description": "Versioned framework, dependency, TypeScript and lint profiles",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omitsuhashi/project-presets-demo.git"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "exports": {
    ".": "./typescript/base.js",
    "./node": "./typescript/node.js",
    "./hono": "./typescript/node.js",
    "./next": "./typescript/next.js",
    "./tsconfig/node.json": "./typescript/tsconfig-node.json",
    "./tsconfig/next.json": "./typescript/tsconfig-next.json"
  },
  "bin": {
    "project-presets": "./scripts/apply-profile.mjs"
  },
  "files": [
    "typescript",
    "./profiles.json",
    "scripts/apply-profile.mjs",
    "scripts/presets",
    "python/project_presets_demo/update-presets.yml"
  ],
  "keywords": [
    "eslint",
    "eslintconfig",
    "typescript",
    "ruff"
  ],
  "scripts": {
    "lint": "eslint typescript scripts tests eslint.config.mjs examples/typescript",
    "test": "pnpm run test:plans && node scripts/check-demo.mjs && pnpm run test:packages",
    "test:plans": "node --test tests/preset-plan.test.mjs && uv run --no-project --python 3.12 python -m unittest discover -s tests -p 'test_*.py'",
    "demo:ts": "eslint --config examples/typescript/eslint.config.mjs examples/typescript/main.ts",
    "demo:py": "uv run --locked ruff check examples/python",
    "test:packages": "uv run --no-project --python 3.12 python scripts/check-release-routing.py && uv run --no-project --python 3.12 python scripts/check-packages.py"
  },
  "dependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "pnpm": "12.8.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "peerDependencies": {
    "eslint-config-next": "^16.3.8"
  },
  "peerDependenciesMeta": {
    "eslint-config-next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "2.1.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint-config-next": "16.3.8",
    "hono": "4.13.12",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
